# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to git!

# Django Settings
SECRET_KEY=your-super-secret-key-here-generate-with-python-command-below
DEBUG=False
ALLOWED_HOSTS=mrbone.ir,www.mrbone.ir,your-server-ip

# Database Settings (PostgreSQL)
DATABASE_NAME=psychology_institute
DATABASE_USER=postgres
DATABASE_PASSWORD=your-strong-database-password-here
DATABASE_HOST=postgres
DATABASE_PORT=5432

# Redis Settings
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Settings (for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@mrbone.ir

# Payment Gateway (ZarinPal for Iran)
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=False

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Domain Settings
DOMAIN_NAME=mrbone.ir
WWW_DOMAIN=www.mrbone.ir

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-ga-id-here

# Instructions:
# 1. Copy this file: cp env.production.example .env.production
# 2. Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 3. Set strong DATABASE_PASSWORD (use a password manager)
# 4. Update ALLOWED_HOSTS with your actual domain and server IP
# 5. Configure email settings for your SMTP provider
# 6. Set up payment gateway credentials
# 7. NEVER commit .env.production to git!
